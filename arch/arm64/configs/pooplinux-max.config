# Help: PoopLinux arm64 opt-in: maximum speed (merged with kernel/configs/pooplinux-max.config)
# CPU_MITIGATIONS is not configurable on arm64: boot with mitigations=off
# No KPTI page-table switch on every kernel entry/exit
# CONFIG_UNMAP_KERNEL_AT_EL0 is not set
# No in-kernel pointer authentication / BTI instructions
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
# CONFIG_ARM64_BTI_KERNEL is not set
