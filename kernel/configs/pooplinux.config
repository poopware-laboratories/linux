# Help: PoopLinux performance-tuned kernel (use on top of defconfig)
CONFIG_LOCALVERSION="-poop"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y

# Codegen: -O2, ThinLTO (requires LLVM=1), no debug info
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_DEBUG_INFO_NONE=y

# Drop runtime debugging overhead (DEBUG_KERNEL itself is forced on by
# EXPERT but costs nothing; it only unhides the options below)
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_PROVE_LOCKING is not set
# CONFIG_LOCK_STAT is not set
# CONFIG_KASAN is not set
# CONFIG_KCSAN is not set
# CONFIG_UBSAN is not set
# CONFIG_KFENCE is not set

# Scheduling: lazy preemption, switchable at boot via preempt=, 1000 Hz tick
CONFIG_PREEMPT_LAZY=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_SCHED_AUTOGROUP=y

# Memory management
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# Compressed swap cache in RAM before hitting disk; LZ4 for speed
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM=y
# Parallel struct page init: faster boot on large-memory machines
CONFIG_DEFERRED_STRUCT_PAGE_INIT=y

# Wine/Proton NT sync primitives for games
CONFIG_NTSYNC=y

# Networking: BBR + fq
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y

# QEMU: boot straight from virtio disk without an initramfs
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
