# Help: PoopLinux opt-in: maximum speed, trades away security hardening (INSECURE)
# Use after pooplinux.config. Includes pooplinux-nomitigations.config.

# No speculative-execution mitigations (Spectre, Meltdown, retbleed, ...);
# arm64 can only do this at boot time with mitigations=off
# CONFIG_CPU_MITIGATIONS is not set

# No syscall auditing
# CONFIG_AUDIT is not set

# No stack hardening instrumentation in every function
CONFIG_INIT_STACK_NONE=y
# CONFIG_STACKPROTECTOR is not set

# Huge pages for every large anonymous mapping, not just madvise()d ones
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
